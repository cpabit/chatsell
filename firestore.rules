rules_version = '2';

// Nadie accede directo a Firestore desde el navegador.
// Solo el servidor de ChatSell lee y escribe, con el SDK de administración,
// que no pasa por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
